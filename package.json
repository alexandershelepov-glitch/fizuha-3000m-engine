{
  "name": "adaptive-3000m-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:layero": "npm run build:web && node scripts/prepare-layero.mjs",
    "dev:web": "vite",
    "preview:web": "vite preview",
    "lint": "eslint src tests web/src e2e",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "audit:training": "node --experimental-strip-types audit/run.ts",
    "audit:12w": "node --experimental-strip-types audit/run12w.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
